{
  "manifest_version": 3,
  "name": "Cookies Kitchen — Export & Import",
  "version": "1.0.0",
  "description": "Export and import browser cookies as JSON. Backup, transfer, or share cookies between browsers and profiles.",
  "browser_specific_settings": {
    "gecko": {
      "id": "cookies-kitchen@turbotech.local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "cookies",
    "activeTab",
    "storage",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cookies Kitchen",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
