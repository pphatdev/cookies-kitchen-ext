{
  "manifest_version": 3,
  "name": "Cookies Kitchen — Export & Import",
  "version": "1.0.0",
  "description": "Export and import browser cookies as JSON. Backup, transfer, or share cookies between browsers and profiles.",
  "browser_specific_settings": {
    "gecko": {
      "id": "hi@pphat.me",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "cookies",
    "activeTab",
    "storage",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cookies Kitchen",
    "default_icon": {
      "16": "icons/favicon-16x16.png",
      "32": "icons/favicon-32x32.png",
      "48": "icons/apple-touch-icon.png",
      "128": "icons/android-chrome-192x192.png",
      "512": "icons/android-chrome-512x512.png"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "icons": {
    "16": "icons/favicon-16x16.png",
    "32": "icons/favicon-32x32.png",
    "48": "icons/apple-touch-icon.png",
    "128": "icons/android-chrome-192x192.png",
    "512": "icons/android-chrome-512x512.png"
  }
}
